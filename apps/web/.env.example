# Copy this file to .env.local. All values are optional during Phase 0.

# Overrides the default public RPC endpoint (mainnet lava / sepolia publicnode).
NEXT_PUBLIC_STARKNET_RPC_URL=

# VERITY contract addresses, populated once the respective gates pass:
#  - VerityAnonymizer after GATE 2
#  - BountyManager    after GATE 3
NEXT_PUBLIC_BOUNTY_MANAGER_ADDRESS=
NEXT_PUBLIC_VERITY_ANONYMIZER_ADDRESS=